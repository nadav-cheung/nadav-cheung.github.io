{#- 构建时生成分类文章计数 JSON -#}
<script id="category-data" type="application/json">
{
  {%- for cat in site.categories.toArray() %}
  "{{ cat.name }}": {{ cat.posts.length }}{% if not loop.last %},{% endif %}
  {%- endfor %}
}
</script>

<script>
(function() {
  function initBookshelf() {
    var old = document.getElementById('bookshelf');
    if (old) old.remove();

    var path = window.location.pathname;
    var isHome = path === '/' || /^\/page\/\d+\/?$/.test(path);
    if (!isHome) return;

    var tpl = document.getElementById('bookshelf-tpl');
    if (!tpl) return;

    var clone = tpl.content.cloneNode(true);

    var dataEl = document.getElementById('category-data');
    if (dataEl) {
      try {
        var counts = JSON.parse(dataEl.textContent);
        clone.querySelectorAll('[data-category]').forEach(function(el) {
          var cat = el.getAttribute('data-category');
          if (counts[cat]) el.textContent = counts[cat] + ' 章';
        });
      } catch(e) {}
    }

    var posts = document.querySelector('.posts-expand');
    if (!posts) return;

    var firstPost = posts.querySelector('.post-block');
    if (firstPost) {
      posts.insertBefore(clone, firstPost);
    } else {
      posts.appendChild(clone);
    }
  }

  initBookshelf();
  document.addEventListener('pjax:complete', initBookshelf);
  document.addEventListener('pjax:popstate', initBookshelf);
})();
</script>
