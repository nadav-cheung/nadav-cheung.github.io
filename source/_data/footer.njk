{#- 页脚：站点运行时间 -#}
<div id="site-time" style="font-family: 'JetBrains Mono', monospace; font-size: 0.85em; color: #a0a0a5; letter-spacing: 0.03em;"></div>
<script>
(function() {
  const start = new Date(2022, 1, 23, 11, 40, 0);
  function update() {
    const diff = Date.now() - start;
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    document.getElementById('site-time').textContent =
      '本站已运行 ' + d + ' 天 ' + h + ' 小时 ' + m + ' 分钟 ' + s + ' 秒';
  }
  update();
  setInterval(update, 1000);
})();
</script>
