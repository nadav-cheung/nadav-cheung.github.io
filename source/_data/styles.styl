// ===============================================================
// 自定义样式 — 优先复用 NexT CSS 变量，确保暗色模式完全统一
// NexT 变量: --content-bg-color, --body-bg-color, --text-color,
//   --link-color, --brand-color 等
// 补充变量: --custom-text-secondary, --custom-text-muted,
//   --custom-border-color, --custom-bg-light, --custom-brand*
// ===============================================================

// ---------------------------------------------------------------
// 侧边栏
// ---------------------------------------------------------------

.site-brand-container
  background: var(--content-bg-color) !important
  border-bottom: 1px solid var(--custom-border-color)

.site-title
  color: var(--text-color) !important
  text-shadow: none !important

.site-brand-container .site-description
  color: var(--custom-text-muted) !important

.sidebar
  background: var(--content-bg-color) !important
  border: 1px solid var(--custom-border-color) !important
  box-shadow: 0 2px 2px 0 rgba(0,0,0,0.12), 0 3px 1px -2px rgba(0,0,0,0.06), 0 1px 5px 0 rgba(0,0,0,0.12) !important
  border-radius: 6px

.sidebar-inner
  background: transparent !important
  box-shadow: none !important

.site-author-name
  color: var(--text-color) !important

.site-description
  color: var(--custom-text-secondary) !important

.site-state-item
  border-color: var(--custom-border-color) !important

.site-state-item-count
  color: var(--brand-color) !important

.site-state-item-name
  color: var(--custom-text-muted) !important

.links-of-author-item a
  color: var(--custom-text-secondary) !important
  border-bottom: none !important
  &:hover
    color: var(--brand-color) !important

.links-of-author-item .fa,
.links-of-author-item .fab,
.links-of-author-item .fas
  color: var(--custom-text-muted) !important

.sidebar .cc-animate
  color: var(--custom-text-muted) !important

.my-wechat-sidebar-image
  width: 88%
  display: block
  margin: 0 auto
  border-radius: 6px

.sidebar iframe
  border-radius: 6px

// ---------------------------------------------------------------
// 导航
// ---------------------------------------------------------------

.header
  margin-bottom: 16px !important

.header-inner
  background: var(--content-bg-color) !important
  border-bottom: 1px solid var(--custom-border-color) !important

.site-nav .menu-item a
  color: var(--custom-text-secondary)
  border-bottom: none !important
  &:hover, &.menu-item-active
    color: var(--brand-color) !important

// ---------------------------------------------------------------
// 文章
// ---------------------------------------------------------------

// 标题层级
.posts-expand .post-title
  font-size: 1.75em

.post-body
  line-height: 1.8

  h2
    font-size: 1.25em
    margin-top: 2em
    margin-bottom: 0.6em
    padding-bottom: 0.3em
    border-bottom: 1px solid var(--custom-border-color)
  h3
    font-size: 1.1em
    margin-top: 1.6em
    margin-bottom: 0.5em
  h4
    font-size: 1em
    margin-top: 1.4em

.post-title a
  color: var(--text-color) !important
  border-bottom: none !important
  &:hover
    color: var(--link-color) !important

.post-meta
  color: var(--custom-text-muted) !important
  a
    color: var(--custom-text-muted) !important
    border-bottom: none !important
    &:hover
      color: var(--link-color) !important

.post-body p a
  color: var(--link-color)
  border-bottom: 1px solid rgba(85, 85, 85, 0.2)
  &:hover
    color: var(--custom-brand-lt)

.post-button .btn
  color: var(--link-color) !important
  background: transparent !important
  border: 1px solid var(--custom-border-color) !important
  border-radius: 4px !important
  box-shadow: none !important
  &:hover
    color: var(--content-bg-color) !important
    background: var(--link-color) !important
    border-color: var(--link-color) !important

// ---------------------------------------------------------------
// 代码
// ---------------------------------------------------------------

code
  background: var(--custom-bg-light)
  color: var(--link-color)
  border-radius: 3px
  padding: 2px 5px
  font-size: 0.88em

pre code
  background: transparent
  color: inherit

.highlight
  background: var(--content-bg-color) !important
  border: 1px solid var(--custom-border-color)
  border-radius: 4px

  pre
    background: var(--content-bg-color) !important

// ---------------------------------------------------------------
// 标签云
// ---------------------------------------------------------------

.tag-cloud a
  color: var(--custom-text-secondary)
  border: 1px solid var(--custom-border-color)
  border-radius: 4px
  padding: 4px 12px
  margin: 4px
  box-shadow: none
  &:hover
    background: var(--link-color)
    color: var(--content-bg-color)
    border-color: var(--link-color)

// ---------------------------------------------------------------
// 分页
// ---------------------------------------------------------------

.pagination .page-number
  color: var(--custom-text-secondary)
  border: 1px solid var(--custom-border-color)
  border-radius: 4px
  box-shadow: none
  &:hover, &.current
    background: var(--link-color)
    color: var(--content-bg-color)
    border-color: var(--link-color)

// ---------------------------------------------------------------
// 页脚
// ---------------------------------------------------------------

.footer
  color: var(--custom-text-muted) !important
  a
    color: var(--custom-text-secondary)
    &:hover
      color: var(--link-color)
  .with-love
    color: var(--custom-text-muted)

// ---------------------------------------------------------------
// 返回顶部
// ---------------------------------------------------------------

.back-to-top
  background: var(--body-bg-color) !important
  color: var(--brand-color) !important
  border: 1px solid var(--custom-border-color)
  box-shadow: none
  &:hover
    background: var(--brand-color) !important
    color: var(--body-bg-color) !important

// ---------------------------------------------------------------
// 搜索
// ---------------------------------------------------------------

.search-icon, .popup-trigger
  color: var(--custom-text-secondary)
  &:hover
    color: var(--link-color)

// ---------------------------------------------------------------
// TOC（文章目录）
// ---------------------------------------------------------------

// 侧边栏导航和面板间距
.sidebar-nav
  margin-bottom: 10px

.post-toc
  .nav-item
    padding: 3px 0
  .nav-link
    color: var(--custom-text-secondary)
    border-bottom: none !important
    line-height: 1.7
    &:hover, &.active
      color: var(--brand-color) !important
  .nav-number
    color: var(--custom-text-muted)
  .nav-child
    padding-left: 12px

// ---------------------------------------------------------------
// 打赏
// ---------------------------------------------------------------

.reward-container button
  background: var(--custom-bg-light)
  color: var(--brand-color)
  border: 1px solid var(--custom-border-color)
  border-radius: 4px
  &:hover
    background: var(--brand-color)
    color: var(--content-bg-color)
    border-color: var(--brand-color)

// ---------------------------------------------------------------
// 进度条
// ---------------------------------------------------------------

.reading-progress-bar
  background: var(--theme-color) !important

// ---------------------------------------------------------------
// GitHub Banner
// ---------------------------------------------------------------

.github-banner
  color: var(--custom-text-secondary) !important
  border-bottom: none !important
  &:hover
    color: var(--link-color) !important

// ---------------------------------------------------------------
// 备案
// ---------------------------------------------------------------

.beian
  color: var(--custom-text-muted)
  a
    color: var(--custom-text-secondary)
  img
    display: inline-block
    margin: 0 2px
    vertical-align: middle
    height: 16px

// ---------------------------------------------------------------
// 书架
// ---------------------------------------------------------------

#bookshelf
  margin: 0 auto 2em
  padding: 2em 1.2em 1em
  background: var(--content-bg-color)
  border-radius: 6px
  border: 1px solid var(--custom-border-color)

.shelf-header
  text-align: center
  margin-bottom: 1.5em
  display: flex
  align-items: center
  justify-content: center
  gap: 12px

.shelf-heading
  font-size: 0.9em
  font-weight: 600
  color: var(--custom-text-secondary)
  letter-spacing: 0.1em

.shelf-line
  display: inline-block
  width: 24px
  height: 1px
  background: var(--custom-border-color)
  flex-shrink: 0

.books-row
  display: flex
  justify-content: center
  gap: 6px
  perspective: 600px

.book-spine
  display: flex
  flex-direction: column
  align-items: center
  justify-content: center
  flex: 1 1 0
  height: 210px
  background: var(--spine-color)
  border-radius: 2px 5px 5px 2px
  cursor: pointer
  text-decoration: none
  position: relative
  box-shadow: inset -3px 0 6px rgba(0, 0, 0, 0.1), 1px 1px 3px rgba(0, 0, 0, 0.06)
  transition: transform 0.25s ease, box-shadow 0.25s ease

.spine-rule
  width: 50%
  height: 1px
  background: rgba(255, 255, 255, 0.2)
  margin: 5px 0

.spine-title
  font-size: 0.82em
  font-weight: 700
  color: rgba(255, 255, 255, 0.92)
  text-align: center
  line-height: 1.5
  padding: 0 6px
  letter-spacing: 0.03em
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.15)

.spine-count
  font-size: 0.6em
  color: rgba(255, 255, 255, 0.6)
  margin-top: 3px

.spine-count.badge-soon
  font-size: 0.52em
  background: rgba(255, 255, 255, 0.12)
  padding: 2px 7px
  border-radius: 4px
  color: rgba(255, 255, 255, 0.7)

.book-spine:hover
  transform: translateY(-14px) scale(1.02)
  box-shadow: inset -3px 0 6px rgba(0, 0, 0, 0.1), 4px 10px 20px rgba(0, 0, 0, 0.12)

.shelf-edge
  height: 2px
  background: var(--custom-border-color)
  margin: 0 2em
  border-radius: 1px

@media (max-width: 768px)
  .books-row
    flex-wrap: wrap
    gap: 5px
  .book-spine
    flex: none
    width: 80px
    height: 165px
  .spine-title
    font-size: 0.68em
  #bookshelf
    margin: 0 1em 2em
    padding: 1.5em 1em 0.8em
  .shelf-edge
    margin: 0 1em

// ---------------------------------------------------------------
// njk 模板用的 CSS class（替代内联样式）
// ---------------------------------------------------------------

.post-qr-wrapper
  text-align: center
  margin-bottom: 1em

.post-qr-image
  max-width: 200px
  border-radius: 6px
  border: 1px solid var(--custom-border-color)

.post-end-notice
  text-align: center
  color: var(--custom-text-muted)
  font-size: 0.85em
  padding: 1.5em 0
  letter-spacing: 0.05em

.site-time-widget
  font-family: 'JetBrains Mono', 'Consolas', monospace
  font-size: 0.85em
  color: var(--custom-text-muted)
  letter-spacing: 0.03em

// ---------------------------------------------------------------
// 滚动条
// ---------------------------------------------------------------

::-webkit-scrollbar
  width: 6px
  height: 6px

::-webkit-scrollbar-track
  background: transparent

::-webkit-scrollbar-thumb
  background: var(--custom-border-color)
  border-radius: 3px
  &:hover
    background: var(--custom-text-muted)

// 侧边栏模块间距
.sidebar-nav
  margin-bottom: 12px
.sidebar-panel
  padding-top: 8px
.site-state
  margin-bottom: 12px
.links-of-author
  margin-top: 8px
  margin-bottom: 8px
