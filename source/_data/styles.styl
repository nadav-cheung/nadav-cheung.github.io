// ===============================================================
// 自定义样式 — 所有颜色引用 variables.styl，不硬编码
// ===============================================================

// ---------------------------------------------------------------
// 侧边栏
// ---------------------------------------------------------------

.site-brand-container
  background: $bg-white !important
  border-bottom: 1px solid $border-color

.site-title
  color: $text-primary !important
  text-shadow: none !important

.site-brand-container .site-description
  color: $text-muted !important

.sidebar
  background: $bg-white !important
  border: 1px solid $border-color !important
  box-shadow: 0 2px 2px 0 rgba(0,0,0,0.12), 0 3px 1px -2px rgba(0,0,0,0.06), 0 1px 5px 0 rgba(0,0,0,0.12) !important
  border-radius: 6px

.sidebar-inner
  background: transparent !important
  box-shadow: none !important

.site-author-name
  color: $text-primary !important

.site-description
  color: $text-secondary !important

.site-state-item
  border-color: $border-color !important

.site-state-item-count
  color: $brand !important

.site-state-item-name
  color: $text-muted !important

.links-of-author-item a
  color: $text-secondary !important
  border-bottom: none !important
  &:hover
    color: $brand !important

.links-of-author-item .fa,
.links-of-author-item .fab,
.links-of-author-item .fas
  color: $text-muted !important

.sidebar .cc-animate
  color: $text-muted !important

.my-wechat-sidebar-image
  width: 88%
  display: block
  margin: 0 auto
  border-radius: 6px

.sidebar iframe
  border-radius: 6px

// ---------------------------------------------------------------
// 导航
// ---------------------------------------------------------------

.header-inner
  background: $bg-white !important
  border-bottom: 1px solid $border-color !important

.site-nav .menu-item a
  color: $text-secondary
  border-bottom: none !important
  &:hover, &.menu-item-active
    color: $brand !important

// ---------------------------------------------------------------
// 文章
// ---------------------------------------------------------------

// 标题层级
.posts-expand .post-title
  font-size: 1.75em

.post-body
  line-height: 1.8

  h2
    font-size: 1.25em
    margin-top: 2em
    margin-bottom: 0.6em
    padding-bottom: 0.3em
    border-bottom: 1px solid $border-color
  h3
    font-size: 1.1em
    margin-top: 1.6em
    margin-bottom: 0.5em
  h4
    font-size: 1em
    margin-top: 1.4em

.post-title a
  color: $text-primary !important
  border-bottom: none !important
  &:hover
    color: $brand !important

.post-meta
  color: $text-muted !important
  a
    color: $text-muted !important
    border-bottom: none !important
    &:hover
      color: $brand !important

.post-body p a
  color: $brand
  border-bottom: 1px solid rgba(85, 85, 85, 0.2)
  &:hover
    color: $brand-lt

.post-button .btn
  color: $brand !important
  background: transparent !important
  border: 1px solid $border-color !important
  border-radius: 4px !important
  box-shadow: none !important
  &:hover
    color: $bg-white !important
    background: $brand !important
    border-color: $brand !important

// ---------------------------------------------------------------
// 代码
// ---------------------------------------------------------------

code
  background: $bg-light
  color: $brand
  border-radius: 3px
  padding: 2px 5px
  font-size: 0.88em

pre code
  background: transparent
  color: inherit

.highlight
  background: $bg-white !important
  border: 1px solid $border-color
  border-radius: 4px

  pre
    background: $bg-white !important

// ---------------------------------------------------------------
// 标签云
// ---------------------------------------------------------------

.tag-cloud a
  color: $text-secondary
  border: 1px solid $border-color
  border-radius: 4px
  padding: 4px 12px
  margin: 4px
  box-shadow: none
  &:hover
    background: $brand
    color: $bg-white
    border-color: $brand

// ---------------------------------------------------------------
// 分页
// ---------------------------------------------------------------

.pagination .page-number
  color: $text-secondary
  border: 1px solid $border-color
  border-radius: 4px
  box-shadow: none
  &:hover, &.current
    background: $brand
    color: $bg-white
    border-color: $brand

// ---------------------------------------------------------------
// 页脚
// ---------------------------------------------------------------

.footer
  color: $text-muted !important
  a
    color: $text-secondary
    &:hover
      color: $brand
  .with-love
    color: $text-muted

// ---------------------------------------------------------------
// 返回顶部
// ---------------------------------------------------------------

.back-to-top
  background: $bg-white !important
  color: $brand !important
  border: 1px solid $border-color
  box-shadow: none
  &:hover
    background: $brand !important
    color: $bg-white !important

// ---------------------------------------------------------------
// 搜索
// ---------------------------------------------------------------

.search-icon, .popup-trigger
  color: $text-secondary
  &:hover
    color: $brand

// ---------------------------------------------------------------
// TOC（文章目录）
// ---------------------------------------------------------------

.post-toc
  .nav-item
    padding: 3px 0
  .nav-link
    color: $text-secondary
    border-bottom: none !important
    line-height: 1.7
    &:hover, &.active
      color: $brand !important
  .nav-number
    color: $text-muted
  .nav-child
    padding-left: 12px

// ---------------------------------------------------------------
// 打赏
// ---------------------------------------------------------------

.reward-container button
  background: $bg-light
  color: $brand
  border: 1px solid $border-color
  border-radius: 4px
  &:hover
    background: $brand
    color: $bg-white
    border-color: $brand

// ---------------------------------------------------------------
// 进度条
// ---------------------------------------------------------------

.reading-progress-bar
  background: $brand !important

// ---------------------------------------------------------------
// GitHub Banner
// ---------------------------------------------------------------

.github-banner
  color: $text-secondary !important
  border-bottom: none !important
  &:hover
    color: $brand !important

// ---------------------------------------------------------------
// 备案
// ---------------------------------------------------------------

.beian
  color: $text-muted
  a
    color: $text-secondary
  img
    display: inline-block
    margin: 0 2px
    vertical-align: middle
    height: 16px

// ---------------------------------------------------------------
// 书架
// ---------------------------------------------------------------

#bookshelf
  margin: 0 auto 2em
  padding: 2em 1.2em 1em
  background: $bg-white
  border-radius: 6px
  border: 1px solid $border-color

.shelf-header
  text-align: center
  margin-bottom: 1.5em
  display: flex
  align-items: center
  justify-content: center
  gap: 12px

.shelf-heading
  font-size: 0.9em
  font-weight: 600
  color: $text-secondary
  letter-spacing: 0.1em

.shelf-line
  display: inline-block
  width: 24px
  height: 1px
  background: $border-color
  flex-shrink: 0

.books-row
  display: flex
  justify-content: center
  gap: 6px
  perspective: 600px

.book-spine
  display: flex
  flex-direction: column
  align-items: center
  justify-content: center
  flex: 1 1 0
  height: 210px
  background: var(--spine-color)
  border-radius: 2px 5px 5px 2px
  cursor: pointer
  text-decoration: none
  position: relative
  box-shadow: inset -3px 0 6px rgba(0, 0, 0, 0.1), 1px 1px 3px rgba(0, 0, 0, 0.06)
  transition: transform 0.25s ease, box-shadow 0.25s ease

.spine-rule
  width: 50%
  height: 1px
  background: rgba(255, 255, 255, 0.2)
  margin: 5px 0

.spine-title
  font-size: 0.82em
  font-weight: 700
  color: rgba(255, 255, 255, 0.92)
  text-align: center
  line-height: 1.5
  padding: 0 6px
  letter-spacing: 0.03em
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.15)

.spine-count
  font-size: 0.6em
  color: rgba(255, 255, 255, 0.6)
  margin-top: 3px

.spine-count.badge-soon
  font-size: 0.52em
  background: rgba(255, 255, 255, 0.12)
  padding: 2px 7px
  border-radius: 4px
  color: rgba(255, 255, 255, 0.7)

.book-spine:hover
  transform: translateY(-14px) scale(1.02)
  box-shadow: inset -3px 0 6px rgba(0, 0, 0, 0.1), 4px 10px 20px rgba(0, 0, 0, 0.12)

.shelf-edge
  height: 2px
  background: $border-color
  margin: 0 2em
  border-radius: 1px

@media (max-width: 768px)
  .books-row
    flex-wrap: wrap
    gap: 5px
  .book-spine
    flex: none
    width: 80px
    height: 165px
  .spine-title
    font-size: 0.68em
  #bookshelf
    margin: 0 1em 2em
    padding: 1.5em 1em 0.8em
  .shelf-edge
    margin: 0 1em

// ---------------------------------------------------------------
// njk 模板用的 CSS class（替代内联样式）
// ---------------------------------------------------------------

.post-qr-wrapper
  text-align: center
  margin-bottom: 1em

.post-qr-image
  max-width: 200px
  border-radius: 6px
  border: 1px solid $border-color

.post-end-notice
  text-align: center
  color: $text-muted
  font-size: 0.85em
  padding: 1.5em 0
  letter-spacing: 0.05em

.site-time-widget
  font-family: 'JetBrains Mono', 'Consolas', monospace
  font-size: 0.85em
  color: $text-muted
  letter-spacing: 0.03em

// ---------------------------------------------------------------
// 滚动条
// ---------------------------------------------------------------

::-webkit-scrollbar
  width: 6px
  height: 6px

::-webkit-scrollbar-track
  background: transparent

::-webkit-scrollbar-thumb
  background: $border-color
  border-radius: 3px
  &:hover
    background: $text-muted
