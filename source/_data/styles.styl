// ===============================================================
// 清雅书房 - 完整自定义样式
// Elegant Pink-White × Editorial Aesthetic
// ===============================================================

// ---------------------------------------------------------------
// CSS 变量（亮色 / 暗色统一管理）
// ---------------------------------------------------------------

:root
  --text-primary: #2d2d32
  --text-body: #3a3a40
  --text-secondary: #8a8a90
  --text-footer-link: #a08580
  --text-nav-number: #b8b0b0
  --accent: #c4908f
  --accent-dark: #b07a79
  --accent-light: #d4a5a5
  --bg-body-start: #ffffff
  --bg-body-end: #fef6f6
  --bg-card: #ffffff
  --bg-sidebar: #fef7f7
  --bg-footer: #fef5f5
  --bg-code: #fdfafa
  --bg-input: #fdfafa
  --bg-header: rgba(255, 255, 255, 0.85)
  --bg-code-inline: rgba(196, 144, 143, 0.06)
  --border: #efe8e8
  --border-light: #e5dada
  --border-hover: #e5dada
  --shadow-card: 0 1px 4px rgba(196, 144, 143, 0.06)
  --shadow-card-hover: 0 6px 16px rgba(196, 144, 143, 0.1)
  --link-border: rgba(196, 144, 143, 0.3)
  --scrollbar-track: #fef6f6
  --scrollbar-thumb: #e0d4d4
  --scrollbar-thumb-hover: #c4908f
  --btn-hover-text: #ffffff
  --btn-hover-bg: #c4908f
  --edge: linear-gradient(90deg, transparent 0%, #e0d4d4 10%, #e0d4d4 90%, transparent 100%)
  --with-love: #e5dada

@media (prefers-color-scheme: dark)
  :root
    --text-primary: #e8e2e2
    --text-body: #c8c2c2
    --text-secondary: #7a7578
    --text-footer-link: #7a7578
    --text-nav-number: #7a7578
    --accent: #d4a5a5
    --accent-dark: #b8908f
    --accent-light: #e8bab8
    --bg-body-start: #0f0e10
    --bg-body-end: #121012
    --bg-card: #1a1819
    --bg-sidebar: #141214
    --bg-footer: #0f0e10
    --bg-code: #141214
    --bg-input: #0f0e10
    --bg-header: rgba(15, 14, 16, 0.85)
    --bg-code-inline: rgba(212, 165, 165, 0.1)
    --border: #2a2628
    --border-light: #2a2628
    --border-hover: #3a3438
    --shadow-card: 0 1px 4px rgba(0, 0, 0, 0.06)
    --shadow-card-hover: 0 6px 16px rgba(0, 0, 0, 0.1)
    --link-border: rgba(212, 165, 165, 0.3)
    --scrollbar-track: #0f0e10
    --scrollbar-thumb: #2a2628
    --scrollbar-thumb-hover: #3a3438
    --btn-hover-text: #0f0e10
    --btn-hover-bg: #d4a5a5
    --edge: linear-gradient(90deg, transparent 0%, #2a2628 10%, #2a2628 90%, transparent 100%)
    --with-love: #2a2628

// ---------------------------------------------------------------
// 基础排版
// ---------------------------------------------------------------

.posts-expand .post-title,
.post-block .post-title,
.site-title
  font-family: 'Source Serif 4', 'Noto Serif SC', 'Georgia', serif !important
  letter-spacing: 0.02em

.site-title
  font-weight: 900
  color: var(--text-primary) !important

.post-body
  font-family: 'Noto Serif SC', 'PingFang SC', 'Microsoft YaHei', serif
  line-height: 2
  color: var(--text-body)

code, pre, .highlight
  font-family: 'JetBrains Mono', 'Consolas', 'Monaco', monospace !important

h1, h2, h3, h4, h5, h6
  font-family: 'Source Serif 4', 'Noto Serif SC', serif
  color: var(--text-primary)
  border-bottom-color: var(--border) !important

// ---------------------------------------------------------------
// 页面背景
// ---------------------------------------------------------------

body
  background: linear-gradient(180deg, var(--bg-body-start) 0%, var(--bg-body-end) 100%) !important
  background-attachment: fixed

// ---------------------------------------------------------------
// 侧边栏
// ---------------------------------------------------------------

.sidebar
  background: var(--bg-sidebar) !important
  box-shadow: 1px 0 0 var(--border)

.sidebar-inner
  background: transparent !important
  box-shadow: none !important

.site-author-image
  border: 3px solid var(--border)
  transition: border-color 0.3s ease
  &:hover
    border-color: var(--accent)

.site-author-name
  color: var(--text-primary) !important
  font-family: 'Source Serif 4', 'Noto Serif SC', serif
  font-weight: 700

.site-state-item
  border-color: var(--border) !important

.site-state-item-count
  color: var(--accent) !important
  font-family: 'JetBrains Mono', monospace

.links-of-author-item a
  border-bottom: none !important
  color: var(--text-secondary)
  transition: all 0.2s ease
  &:hover
    color: var(--accent)
    transform: translateX(4px)

// ---------------------------------------------------------------
// 文章卡片
// ---------------------------------------------------------------

.post-block
  background: var(--bg-card) !important
  border: 1px solid var(--border)
  border-radius: 8px !important
  padding: 2em !important
  margin-bottom: 1.5em !important
  transition: border-color 0.3s ease, box-shadow 0.3s ease
  box-shadow: var(--shadow-card)
  &:hover
    border-color: var(--border-hover)
    box-shadow: var(--shadow-card-hover)

.post-title
  a
    color: var(--text-primary) !important
    border-bottom: none !important
    transition: color 0.2s ease
    &:hover
      color: var(--accent) !important

.post-meta
  color: var(--text-secondary) !important
  a
    color: var(--text-secondary) !important
    border-bottom: none !important
    &:hover
      color: var(--accent) !important

.post-button .btn
  color: var(--accent) !important
  background: transparent
  border: 1px solid var(--border-light) !important
  border-radius: 6px !important
  padding: 8px 24px !important
  font-family: 'Source Serif 4', 'Noto Serif SC', serif
  font-size: 0.9em
  letter-spacing: 0.03em
  transition: all 0.3s ease
  box-shadow: none !important
  &:hover
    color: var(--btn-hover-text) !important
    background: var(--btn-hover-bg) !important
    border-color: var(--btn-hover-bg) !important

.post-body p a
  color: var(--accent)
  border-bottom: 1px solid var(--link-border)
  &:hover
    color: var(--accent-dark)
    border-bottom-color: var(--accent-dark)

// ---------------------------------------------------------------
// 导航菜单
// ---------------------------------------------------------------

.header-inner
  background: var(--bg-header) !important
  backdrop-filter: blur(12px)
  -webkit-backdrop-filter: blur(12px)

.site-nav .menu-item a
  color: var(--text-secondary)
  border-bottom: none !important
  transition: color 0.2s ease
  &:hover, &.menu-item-active
    color: var(--accent)

// ---------------------------------------------------------------
// 代码块
// ---------------------------------------------------------------

.highlight
  background: var(--bg-code) !important
  border: 1px solid var(--border)
  border-radius: 6px

code
  background: var(--bg-code-inline)
  color: var(--accent-dark)
  border-radius: 3px
  padding: 2px 6px
  font-size: 0.9em

.copy-btn
  color: var(--text-secondary) !important
  border-color: var(--border) !important
  background: var(--bg-code) !important
  &:hover
    color: var(--accent) !important

// ---------------------------------------------------------------
// 标签云
// ---------------------------------------------------------------

.tag-cloud a
  box-shadow: var(--shadow-card)
  padding: 4px 14px
  margin: 8px
  background: var(--bg-card)
  border: 1px solid var(--border)
  border-bottom: none
  border-radius: 20px
  color: var(--text-secondary)
  transition: all 0.2s ease
  font-family: 'JetBrains Mono', monospace
  font-size: 0.85em

.tag-cloud-tags a:hover
  background: var(--accent)
  color: var(--btn-hover-text)
  border-color: var(--accent)
  transform: scale(1.05)

// ---------------------------------------------------------------
// 页脚
// ---------------------------------------------------------------

.footer
  background: var(--bg-footer) !important
  color: var(--text-secondary)
  a
    color: var(--text-footer-link)
    &:hover
      color: var(--accent)
  .with-love
    color: var(--with-love)

.beian
  color: var(--text-secondary)
  a
    color: var(--text-footer-link)
  img
    display: inline-block
    margin: 0 3px
    vertical-align: middle
    height: 20px

// ---------------------------------------------------------------
// 返回顶部
// ---------------------------------------------------------------

.back-to-top
  background: var(--bg-card) !important
  color: var(--accent) !important
  border: 1px solid var(--border)
  &:hover
    background: var(--btn-hover-bg) !important
    color: var(--btn-hover-text) !important

// ---------------------------------------------------------------
// 搜索
// ---------------------------------------------------------------

.search-popup
  background: var(--bg-card) !important
  border: 1px solid var(--border)

.search-popup .search-input
  background: var(--bg-input) !important
  border: 1px solid var(--border)
  color: var(--text-primary)

.search-popup .search-result-container
  .search-result-list a
    color: var(--text-primary)
    &:hover
      color: var(--accent)
  .search-result-list p
    color: var(--text-secondary)

.search-icon, .popup-trigger
  color: var(--text-secondary)
  &:hover
    color: var(--accent)

// ---------------------------------------------------------------
// 阅读进度条
// ---------------------------------------------------------------

.reading-progress-bar
  background: linear-gradient(90deg, var(--accent), var(--accent-light)) !important

// ---------------------------------------------------------------
// 分页
// ---------------------------------------------------------------

.pagination .page-number
  background: var(--bg-card)
  color: var(--text-secondary)
  border: 1px solid var(--border)
  border-radius: 6px
  transition: all 0.2s ease
  &:hover, &.current
    background: var(--accent)
    color: var(--btn-hover-text)
    border-color: var(--accent)

// ---------------------------------------------------------------
// 打赏
// ---------------------------------------------------------------

.reward-container button
  background: var(--bg-code)
  color: var(--accent)
  border: 1px solid var(--border)
  border-radius: 6px
  transition: all 0.3s ease
  &:hover
    background: var(--accent)
    color: var(--btn-hover-text)
    border-color: var(--accent)

// ---------------------------------------------------------------
// TOC 目录
// ---------------------------------------------------------------

.toc .nav-item .nav-link
  color: var(--text-secondary)
  border-bottom: none !important
  transition: color 0.2s ease
  &:hover, &.active
    color: var(--accent) !important

.toc .nav-item .nav-number
  color: var(--text-nav-number)

// ---------------------------------------------------------------
// 微信公众号
// ---------------------------------------------------------------

.my-wechat-sidebar-image
  width: 93%
  display: flex
  justify-content: center

// ---------------------------------------------------------------
// GitHub Banner
// ---------------------------------------------------------------

.github-banner
  color: var(--text-secondary) !important
  border-bottom: none !important
  &:hover
    color: var(--accent) !important

// ---------------------------------------------------------------
// 书架组件
// ---------------------------------------------------------------

#bookshelf
  margin: 0 auto 2.5em
  padding: 2.5em 2em 1em

.shelf-header
  text-align: center
  margin-bottom: 2em
  display: flex
  align-items: center
  justify-content: center
  gap: 16px

.shelf-heading
  font-family: 'Source Serif 4', 'Noto Serif SC', serif
  font-size: 1.1em
  font-weight: 700
  color: var(--text-primary)
  letter-spacing: 0.15em

.shelf-line
  display: inline-block
  width: 40px
  height: 1px
  background: var(--accent)
  flex-shrink: 0

.books-row
  display: flex
  justify-content: center
  gap: 3px
  perspective: 600px

.book-spine
  display: flex
  flex-direction: column
  align-items: center
  justify-content: center
  width: 88px
  height: 210px
  background: var(--spine-color)
  border-radius: 2px 4px 4px 2px
  cursor: pointer
  text-decoration: none
  position: relative
  box-shadow: inset -2px 0 4px rgba(0, 0, 0, 0.08), 1px 0 2px rgba(0, 0, 0, 0.04)
  transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease

.spine-rule
  width: 55%
  height: 1px
  background: rgba(255, 255, 255, 0.25)
  margin: 6px 0

.spine-title
  font-family: 'Noto Serif SC', serif
  font-size: 0.8em
  font-weight: 700
  color: #fff
  text-align: center
  line-height: 1.5
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1)
  padding: 0 6px
  letter-spacing: 0.04em

.spine-count
  font-family: 'JetBrains Mono', monospace
  font-size: 0.62em
  color: rgba(255, 255, 255, 0.6)
  margin-top: 4px
  letter-spacing: 0.03em

.spine-count.badge-soon
  font-family: 'Noto Serif SC', serif
  font-size: 0.56em
  background: rgba(255, 255, 255, 0.12)
  padding: 2px 8px
  border-radius: 6px
  color: rgba(255, 255, 255, 0.72)

.book-spine:hover
  transform: translateY(-14px)
  background: var(--spine-hover)
  box-shadow: inset -2px 0 4px rgba(0, 0, 0, 0.08), 4px 8px 18px rgba(0, 0, 0, 0.1)

.shelf-edge
  height: 2px
  background: var(--edge)
  margin: 0 2em
  border-radius: 1px

@media (max-width: 768px)
  .books-row
    flex-wrap: wrap
    gap: 6px
    justify-content: center
  .book-spine
    width: 72px
    height: 170px
  .spine-title
    font-size: 0.72em
  #bookshelf
    margin: 0 1em 2em
    padding: 1.5em 1em 0.8em
  .shelf-edge
    margin: 0 1em

// ---------------------------------------------------------------
// 滚动条
// ---------------------------------------------------------------

::-webkit-scrollbar
  width: 6px
  height: 6px

::-webkit-scrollbar-track
  background: var(--scrollbar-track)

::-webkit-scrollbar-thumb
  background: var(--scrollbar-thumb)
  border-radius: 3px
  &:hover
    background: var(--scrollbar-thumb-hover)

// ---------------------------------------------------------------
// 暗色模式补充（无法用变量表达的样式）
// ---------------------------------------------------------------

@media (prefers-color-scheme: dark)
  #bookshelf
    background: transparent !important
    border-color: transparent !important
