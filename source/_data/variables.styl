// ===============================================================
// 清雅书房 - 主题变量覆盖
// Elegant Pink-White × Editorial Aesthetic
// ===============================================================

// 品牌色 — 淡玫瑰 (dusty rose)
$rose          = #c4908f
$rose-dk       = #b07a79
$rose-dim      = #a08580

// 背景 — 白至粉白渐变
$body-bg-color                = #ffffff
$content-bg-color             = #ffffff
$card-bg-color                = #fef7f7

// 文字 — 墨色
$text-color                   = #2d2d32
$blockquote-color             = #8a8a90

// 链接
$link-color                   = $rose
$link-hover-color             = $rose-dk
$link-decoration-color        = rgba($rose, 0.3)

// 选择
$selection-bg                 = $rose
$selection-color              = #ffffff

// 表格
$table-border-color           = #efe8e8
$table-cell-border-bottom-color = #efe8e8
$table-row-odd-bg-color       = #fdf8f8
$table-row-hover-bg-color     = #fef5f5

// 按钮
$btn-default-bg               = $rose
$btn-default-color            = #ffffff
$btn-default-border-color     = $rose
$btn-default-hover-bg         = $rose-dk
$btn-default-hover-color      = #ffffff
$btn-default-hover-border-color = $rose-dk
