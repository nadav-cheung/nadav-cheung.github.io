// ===============================================================
// 设计令牌 (Design Tokens) — 全站颜色唯一定义处
// ===============================================================

// 品牌
$brand       = #555555
$brand-dk    = #333333
$brand-lt    = #777777

// 文字（浅色）
$text-primary   = #1a1a1a
$text-secondary = #666666
$text-muted     = #777777

// 背景（浅色）
$bg-white = #ffffff
$bg-light = #f8f8f8

// 边框（浅色）
$border-color = #e8e8e8

// ===============================================================
// 补充 CSS 自定义属性 — NexT 未覆盖的部分
// NexT 已定义: --body-bg-color, --content-bg-color, --text-color,
//   --card-bg-color, --link-color 等 (见 _colors.styl)
// 我们只补充: secondary text, muted text, border, light bg
// 暗色值严格对齐 NexT 色板 (#282828/#333/#ccc/#555)
// ===============================================================

:root
  --custom-text-secondary: $text-secondary
  --custom-text-muted: $text-muted
  --custom-bg-light: $bg-light
  --custom-border-color: $border-color
  --custom-brand: $brand
  --custom-brand-dk: $brand-dk
  --custom-brand-lt: $brand-lt

@media (prefers-color-scheme: dark)
  :root
    --custom-text-secondary: #aaa
    --custom-text-muted: #999
    --custom-bg-light: #282828
    --custom-border-color: #555
    --custom-brand: #ccc
    --custom-brand-dk: #ddd
    --custom-brand-lt: #999

// ===============================================================
// NexT 主题变量覆盖 — 全部引用上方令牌
// ===============================================================

// 背景
$body-bg-color                  = $bg-white
$content-bg-color               = $bg-white
$card-bg-color                  = $bg-light

// 文字
$text-color                     = $text-primary
$blockquote-color               = $text-muted

// 品牌（覆盖 NexT 默认 white，适配浅色背景）
$brand-color                    = $brand
$brand-hover-color              = $brand-dk

// 链接
$link-color                     = $brand
$link-hover-color               = $brand-dk
$link-decoration-color          = rgba($brand, 0.2)

// 选中
$selection-bg                   = $brand
$selection-color                = $bg-white

// 表格
$table-border-color             = $border-color
$table-cell-border-bottom-color = $border-color
$table-row-odd-bg-color         = $bg-light
$table-row-hover-bg-color       = $bg-light

// 按钮
$btn-default-bg                 = $brand
$btn-default-color              = $bg-white
$btn-default-border-color       = $brand
$btn-default-hover-bg           = $brand-dk
$btn-default-hover-color        = $bg-white
$btn-default-hover-border-color = $brand-dk
